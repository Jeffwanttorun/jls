---
import KnowledgeRoutePage from "../../components/KnowledgeRoutePage.astro";
import { knowledgeRoutes } from "../../data/knowledge-routes";
export function getStaticPaths(){return knowledgeRoutes.filter((route)=>route.published).map((route)=>({params:{slug:route.slug},props:{route}}));}
const { route }=Astro.props;
---
<KnowledgeRoutePage {route} locale="en" />
