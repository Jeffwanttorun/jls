---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PublicWuyishanMap from "../../components/PublicWuyishanMap.astro";
const site = Astro.site ?? new URL("https://local-dad-jeff.vercel.app");
const alternates = [{lang:"en" as const,href:new URL("/map",site).toString()},{lang:"zh" as const,href:new URL("/zh/map",site).toString()}];
---
<BaseLayout title="武夷山奶爸地图｜Local Dad Jeff" description="一个本地爸爸根据实地经历整理的武夷山旅行地图，从一号风景道开始，记录玩水、风景、自然、茶、展馆和吃东西的地点，并保护不适合公开的精确位置。" lang="zh" {alternates}>
  <section class="bilingual-entry"><div><p class="kicker">武夷山奶爸地图</p><h1>沿着一条路<br/><em>认识武夷山</em></h1><p class="lead">地图使用本人已经实地走过并完成定位的地点、游客主题和一号风景道路线，帮助你沿路查看位置并安排停留。</p><div class="entry-actions"><a class="primary" href="/zh/explore-wuyishan">先看怎么玩</a></div></div><div id="corridor" class="route-preview"><p class="kicker">一号风景道</p><h2>南源岭至坳头方向</h2><ol><li>南源岭</li><li>星村</li><li>漫水桥</li><li>黄村与红星</li><li>月亮湾与桃源峪方向</li><li>桐木、大竹岚与坳头</li></ol></div></section>
  <PublicWuyishanMap locale="zh" />
</BaseLayout>
