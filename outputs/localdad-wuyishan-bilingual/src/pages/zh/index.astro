---
import BaseLayout from "../../layouts/BaseLayout.astro";
const site = Astro.site ?? new URL("https://local-dad-jeff.vercel.app");
const alternates = [
  { lang:"en" as const, href:new URL("/", site).toString() },
  { lang:"zh" as const, href:new URL("/zh", site).toString() },
];
---
<BaseLayout lang="zh" title="认识武夷山｜武夷山奶爸" description="从山水、茶、人文和自然四个相互关联的章节认识武夷山，理解这里的地方生活、生物多样性与环境，也为想走进武夷山的旅行者提供清楚、实用的入口。" image="/images/wuyishan-river-hero.jpg" {alternates}>
  <section class="photo-hero zh-home-hero">
    <picture><source srcset="/images/wuyishan-river-hero.webp" media="(min-width: 961px)" type="image/webp" /><img src="/images/wuyishan-river-hero.jpg" srcset="/images/wuyishan-river-hero-640.jpg 640w, /images/wuyishan-river-hero-960.jpg 960w, /images/wuyishan-river-hero.jpg 1672w" sizes="100vw" alt="晨雾中的武夷山九曲溪与青山" width="1672" height="940" loading="eager" fetchpriority="high" decoding="async" /></picture>
    <div class="photo-shade"></div>
    <div class="photo-hero-copy">
      <p class="kicker">一手记录 · 福建武夷山</p>
      <h1>认识武夷山<br/><em>从山水到生活</em></h1>
      <p class="lead">从本地视角理解山水、茶、人文、自然与日常生活。</p>
    </div>
    <p class="photo-caption">九曲溪晨雾 · 福建武夷山</p>
  </section>

  <section class="homepage-introduction" aria-labelledby="zh-homepage-introduction-title">
    <div><p class="kicker">为什么是武夷山</p><h2 id="zh-homepage-introduction-title">理解一片<br/>彼此相连的地方。</h2></div>
    <div class="homepage-introduction-copy">
      <p>这里的山水、茶、人文、自然与日常生活彼此连接。先理解这些关系，再决定自己想怎样认识武夷山。</p>
      <p class="project-note">这个网站从实地走访、资料核对和得到授权的真实故事中逐步积累内容。</p>
      <a class="text-link" href="/zh/why-wuyishan">进入四个章节 →</a>
    </div>
  </section>

  <section class="heritage-section" aria-labelledby="zh-heritage-title">
    <h2 id="zh-heritage-title" class="visually-hidden">认识武夷山的四个章节</h2>
    <div class="heritage-grid">
      <section><a href="/zh/why-wuyishan#landscape"><span>01</span><div><h3>山水</h3><p>山峰、溪流、岩壁与行走路径。</p></div></a></section>
      <section><a href="/zh/why-wuyishan#tea"><span>02</span><div><h3>茶</h3><p>自然环境、制茶技艺与当地生活。</p></div></a></section>
      <section><a href="/zh/why-wuyishan#culture"><span>03</span><div><h3>人文</h3><p>村落、历史、思想与地方生活留下的记忆。</p></div></a></section>
      <section><a href="/zh/why-wuyishan#nature"><span>04</span><div><h3>自然</h3><p>森林、生物多样性、植物、昆虫与自然观察。</p></div></a></section>
    </div>
  </section>

  <section class="homepage-paths" aria-labelledby="zh-explore-title">
    <div><p class="kicker">探索武夷山</p><h2 id="zh-explore-title">按自己的兴趣开始。</h2><a class="text-link" href="/zh/explore-wuyishan">查看全部主题 →</a></div>
    <nav aria-label="探索武夷山">
      <a href="/zh/theme/water">玩水与河边体验 <span aria-hidden="true">→</span></a>
      <a href="/zh/theme/scenery">沿路风景 <span aria-hidden="true">→</span></a>
      <a href="/zh/theme/nature">自然观察 <span aria-hidden="true">→</span></a>
      <a href="/zh/theme/museum">茶与展馆 <span aria-hidden="true">→</span></a>
    </nav>
  </section>

  <section class="homepage-stories" aria-labelledby="zh-stories-title">
    <p class="kicker">武夷山故事</p>
    <h2 id="zh-stories-title">记录这里的人与日常。</h2>
    <p>记录当地人的工作、村庄、茶和日常生活，说明人与这片地方的联系。</p>
    <a class="text-link" href="/zh/stories-of-wuyishan">阅读武夷山故事 →</a>
  </section>

  <section class="homepage-about" aria-labelledby="zh-about-jeff-title">
    <figure class="editorial-photo"><picture><source srcset="/images/wuyi-rock-tea-garden.webp" media="(min-width: 1200px)" type="image/webp" /><img src="/images/wuyi-rock-tea-garden.jpg" srcset="/images/wuyi-rock-tea-garden-640.jpg 640w, /images/wuyi-rock-tea-garden-960.jpg 960w, /images/wuyi-rock-tea-garden.jpg 1400w" sizes="(max-width: 800px) 88vw, 50vw" alt="武夷山岩壁旁的茶园" width="1400" height="933" loading="lazy" decoding="async" /></picture><figcaption>岩壁与山谷之间的武夷茶园。</figcaption></figure>
    <div>
      <p class="kicker">关于 Jeff</p>
      <h2 id="zh-about-jeff-title">你好，我是 Jeff。</h2>
      <p>我生活在武夷山，也在这里带孩子、工作、拍摄和继续学习。</p>
      <p>我会分享自己熟悉的地点，也整理理解这片地方所需要的背景和本地经验。</p>
      <a class="text-link" href="/zh/about">关于 Jeff →</a>
    </div>
  </section>
</BaseLayout>
