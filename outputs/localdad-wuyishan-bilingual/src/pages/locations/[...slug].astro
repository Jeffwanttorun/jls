---
import { getCollection, render, type CollectionEntry } from "astro:content";
import LocationPage from "../../components/LocationPage.astro";
import MapSection from "../../components/MapSection.astro";
import { publishedLocations } from "../../data/locations";
import { buildSiteContentRegistry } from "../../lib/site-content-registry";
import { mergeResolvedReferences } from "../../lib/relationships";
export async function getStaticPaths() {
  const entries = await getCollection("locations") as CollectionEntry<"locations">[];
  return publishedLocations.map((pageData) => {
    const entry = entries.find(({ data }) => data.recordKey === pageData.slug && data.lang === (pageData.lang ?? "en"));
    if (!entry) throw new Error(`Missing narrative content for location: ${pageData.slug}`);
    return { params: { slug: pageData.slug }, props: { entry, pageData } };
  });
}
interface Props { entry: CollectionEntry<"locations">; pageData: (typeof publishedLocations)[number]; }
const { entry, pageData } = Astro.props as Props;
const { Content } = await render(entry);
const registry = await buildSiteContentRegistry();
const lang = pageData.lang ?? "en";
const resolvedPageData = {
  ...pageData,
  relatedRoutes:mergeResolvedReferences(registry, "route", pageData.relatedRoutes ?? [], pageData.relatedRouteIds ?? [], lang),
  relatedStories:mergeResolvedReferences(registry, "story", pageData.relatedStories ?? [], pageData.relatedStoryIds ?? [], lang),
};
---
<LocationPage {...resolvedPageData}>
  <Content />
  {pageData.coordinates && <MapSection slot="map" title={`Where ${pageData.englishName} is`} placeName={pageData.englishName} latitude={pageData.coordinates.latitude} longitude={pageData.coordinates.longitude} zoom={12} note={pageData.mapNote} />}
</LocationPage>
