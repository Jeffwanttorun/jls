---
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicWuyishanMap from "../components/PublicWuyishanMap.astro";
const site = Astro.site ?? new URL("https://local-dad-jeff.vercel.app");
const alternates = [{lang:"en" as const,href:new URL("/map",site).toString()},{lang:"zh" as const,href:new URL("/zh/map",site).toString()}];
---
<BaseLayout title="Wuyishan Local Dad Map | Local Dad Jeff" description="An English interface for the same Wuyishan knowledge map, with reviewed place names, Chinese originals, route relationships, and firsthand status." lang="en" {alternates}>
  <section class="bilingual-entry"><div><p class="kicker">Wuyishan Local Dad Map</p><h1>Follow the road.<br/><em>Understand the place.</em></h1><p class="lead">This map uses the same reviewed places, coordinates, route, photos, and field-check status as the Chinese map. Chinese place names remain available for navigation and asking locally.</p><div class="entry-actions"><a class="primary" href="/route/no-1-scenic-road">Open No. 1 Scenic Road</a><a href="/explore-wuyishan">Explore Wuyishan</a></div></div><a id="corridor" class="route-preview" href="/route/no-1-scenic-road"><p class="kicker">No. 1 Scenic Road</p><h2>From Nanyuanling toward Aotou</h2><ol><li>Nanyuanling · 南源岭</li><li>Xingcun · 星村</li><li>Huangcun · 黄村</li><li>Hongxing · 红星</li><li>Tongmu area · 桐木方向</li><li>Aotou · 坳头</li></ol></a></section>
  <PublicWuyishanMap locale="en" />
</BaseLayout>
