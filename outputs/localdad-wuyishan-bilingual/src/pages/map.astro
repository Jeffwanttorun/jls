---
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicWuyishanMap from "../components/PublicWuyishanMap.astro";
const site = Astro.site ?? new URL("https://local-dad-jeff.vercel.app");
const alternates = [{lang:"en" as const,href:new URL("/map",site).toString()},{lang:"zh" as const,href:new URL("/zh/map",site).toString()}];
---
<BaseLayout title="Wuyishan Local Dad Map | Local Dad Jeff" description="A bilingual map for exploring Wuyishan through firsthand local notes, family-friendly stops, nature, tea, museums, and the No. 1 Scenic Road." lang="en" {alternates}>
  <section class="bilingual-entry"><div><p class="kicker">Wuyishan Local Dad Map</p><h1>Follow the road.<br/><em>Understand the place.</em></h1><p class="lead">The public map is being connected to the same reviewed place records used by the Chinese visitor map. Precise locations remain available only where public sharing has been approved.</p><div class="entry-actions"><a class="primary" href="/zh/map">打开中文地图入口</a><a href="/explore-wuyishan">Explore Wuyishan</a></div></div><div id="corridor" class="route-preview"><p class="kicker">No. 1 Scenic Road</p><h2>From Nanyuanling toward Aotou</h2><ol><li>Nanyuanling · 南源岭</li><li>Xingcun · 星村</li><li>Huangcun · 黄村</li><li>Hongxing · 红星</li><li>Tongmu area · 桐木方向</li><li>Aotou · 坳头</li></ol></div></section>
  <PublicWuyishanMap locale="en" />
</BaseLayout>
