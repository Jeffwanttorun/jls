---
import { getCollection, render, type CollectionEntry } from "astro:content";
import EditorialLayout from "../../layouts/EditorialLayout.astro";
import { contentSections } from "../../data/content-sections";
import { hasMarkdownFiles } from "../../lib/content-files";
import { alternateEditorialPaths, editorialPath, editorialRouteParams, validateLocalizedEntries, type LocalizedEntry } from "../../lib/localized-content";
import type { Locale } from "../../i18n/config";
import { buildSiteContentRegistry } from "../../lib/site-content-registry";
import { mergeResolvedReferences, resolveContentReferences } from "../../lib/relationships";
import { inspectEditorialBody } from "../../lib/editorial-body";

export async function getStaticPaths() {
  await buildSiteContentRegistry();
  const paths = [];
  for (const section of contentSections) {
    if (!hasMarkdownFiles(section.contentPath)) continue;
    const entries = await getCollection(section.collection);
    const localizedEntries = entries as unknown as LocalizedEntry[];
    validateLocalizedEntries(localizedEntries, section.collection);
    for (const entry of entries) {
      if (entry.data.recordStatus === "published") {
        const pathname = editorialPath(section.path, entry.data.slug, entry.data.lang as Locale);
        paths.push({ params:editorialRouteParams(pathname), props:{ entry, sectionLabel:section.label, pillarLabel:section.pillarLabel, alternatePaths:alternateEditorialPaths(localizedEntries, entry as unknown as LocalizedEntry, section.path) } });
      }
    }
  }
  return paths;
}

type EditorialEntry = CollectionEntry<"people"> | CollectionEntry<"routes"> | CollectionEntry<"teaArticles"> | CollectionEntry<"familyGuides"> | CollectionEntry<"localStories"> | CollectionEntry<"knowledgeArticles">;
interface Props { entry: EditorialEntry; sectionLabel: string; pillarLabel: string; alternatePaths: Array<{lang: Locale; path: string}>; }
const { entry, sectionLabel, pillarLabel, alternatePaths } = Astro.props as Props;
const { Content } = await render(entry);
const alternates = Astro.site ? alternatePaths.map((item) => ({ lang:item.lang, href:new URL(item.path, Astro.site!).toString() })) : [];
const registry = await buildSiteContentRegistry();
const lang = entry.data.lang as Locale;
const relatedPlaces = mergeResolvedReferences(registry, "place", entry.data.relatedPlaces ?? [], entry.data.relatedPlaceIds ?? [], lang);
const relatedPeople = mergeResolvedReferences(registry, "person", entry.data.relatedPeople ?? [], entry.data.relatedPersonIds ?? [], lang);
const relatedStories = mergeResolvedReferences(registry, "story", entry.data.relatedStories ?? [], entry.data.relatedStoryIds ?? [], lang);
const relatedRoutes = mergeResolvedReferences(registry, "route", entry.data.relatedRoutes ?? [], entry.data.relatedRouteIds ?? [], lang);
const relatedKnowledge = mergeResolvedReferences(registry, "knowledge", [], entry.data.relatedKnowledgeIds ?? [], lang);
const relatedGuides = resolveContentReferences(registry, "guide", entry.data.relatedGuideIds ?? [], lang);
const bodySections = inspectEditorialBody((entry as typeof entry & { body?: string }).body);
---
<EditorialLayout {...entry.data} seoTitle={entry.data.seoTitle} published={entry.data.published!} relatedPlaces={relatedPlaces} relatedPeople={relatedPeople} relatedStories={relatedStories} relatedRoutes={relatedRoutes} relatedKnowledge={relatedKnowledge} relatedGuides={relatedGuides} renderStructuredSources={!bodySections.includesSources} sectionLabel={sectionLabel} pillarLabel={pillarLabel} alternates={alternates}><Content /></EditorialLayout>
