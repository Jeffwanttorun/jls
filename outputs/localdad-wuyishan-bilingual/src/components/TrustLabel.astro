---
import { trustLabels, type TrustStatus } from "../data/editorial";
interface Props { status: TrustStatus; compact?: boolean; }
const { status, compact = false } = Astro.props;
const item = trustLabels[status];
---
<a class:list={["trust-label", `trust-${status}`, { compact }]} href="/editorial-standards" aria-label={`${item.label}. ${item.description} Read the editorial standards.`}>
  <span aria-hidden="true"></span>
  <div><strong>{item.label}</strong>{!compact && <p>{item.description}</p>}<small>Editorial standard <span aria-hidden="true">→</span></small></div>
</a>
