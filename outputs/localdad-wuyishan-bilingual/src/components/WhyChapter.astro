---
interface ChapterLink { title:string; href:string; note?:string; }
interface Props {
  number:string;
  id:string;
  title:string;
  image:string;
  imageAlt:string;
  links?:ChapterLink[];
}
const { number, id, title, image, imageAlt, links = [] } = Astro.props;
---
<section id={id} class="why-chapter" aria-labelledby={`${id}-heading`}>
  <div class="why-chapter-cover">
    <img src={image} alt={imageAlt} width="960" height="640" loading="lazy" decoding="async" />
    <div class="why-chapter-shade"></div>
    <div class="why-chapter-heading">
      <span class="why-chapter-number" aria-hidden="true">{number}</span>
      <h2 id={`${id}-heading`}>{title}</h2>
    </div>
  </div>
  <div class="why-chapter-content">
    {links.length > 0 && <nav aria-label={`${title} articles`}>
      {links.map((link) => <a href={link.href}><span>{link.title}{link.note && <small>{link.note}</small>}</span><b aria-hidden="true">→</b></a>)}
    </nav>}
  </div>
</section>
