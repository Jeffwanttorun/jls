---
import type { VideoRecord } from "../types/content";

interface Props {
  video: VideoRecord;
  watchLabel: string;
}

const { video, watchLabel } = Astro.props;
---
<article class="video-card">
  {video.thumbnail && <a class="video-card-image" href={video.url} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true"><img src={video.thumbnail.src} alt="" width={video.thumbnail.width} height={video.thumbnail.height} loading="lazy" decoding="async" /></a>}
  <div>
    <p class="kicker">{video.platform === "youtube" ? "YouTube" : "Instagram"}</p>
    <h3><a href={video.url} target="_blank" rel="noopener noreferrer">{video.title}</a></h3>
    {video.description && <p>{video.description}</p>}
    <a class="text-link" href={video.url} target="_blank" rel="noopener noreferrer">{watchLabel} <span aria-hidden="true">↗</span></a>
  </div>
</article>

<style>
  .video-card{display:grid;grid-template-columns:minmax(8rem,14rem) 1fr;gap:1.25rem;padding:1.25rem 0;border-bottom:1px solid var(--line)}.video-card-image{display:block;aspect-ratio:16/9;overflow:hidden;background:var(--cream)}.video-card-image img{width:100%;height:100%;object-fit:cover}.video-card h3{margin:.2rem 0 .55rem}.video-card p{margin:.35rem 0 .75rem}@media(max-width:620px){.video-card{grid-template-columns:1fr}.video-card-image{max-width:none}}
</style>
