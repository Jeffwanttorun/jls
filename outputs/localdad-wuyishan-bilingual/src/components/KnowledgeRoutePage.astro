---
import BaseLayout from "../layouts/BaseLayout.astro";
import MapExplorer from "./MapExplorer.astro";
import { knowledgePlaceById, localizedPlaceName } from "../data/knowledge-places";
import { buildRouteMapDataset } from "../data/wuyishan-public-map";
import type { Locale } from "../i18n/config";
import type { KnowledgeRoute } from "../types/knowledge-map";
import { localizedPublicMapFilterLabels } from "../data/map-filters";

interface Props { route:KnowledgeRoute; locale:Locale; }
const { route,locale }=Astro.props;
const zh=locale==="zh";
const name=zh?route.nameZh:route.nameEn;
const summary=zh?route.summaryZh:route.summaryEn;
const places=route.placeIds.flatMap((id)=>{const place=knowledgePlaceById.get(id);return place?[place]:[]});
const recheck=places.filter((place)=>place.trustStatus?.recheckBeforeGoing);
const corePlaces=route.places.filter((relationship)=>relationship.role==="core-stop").flatMap((relationship)=>{const place=knowledgePlaceById.get(relationship.placeId);return place?[place]:[]});
const coreStopCount=corePlaces.length;
const verifiedCoreCount=corePlaces.filter((place)=>place.trustStatus?.checkedInPerson===true).length;
const practicalNotes=zh?route.practicalNotesZh:route.practicalNotesEn;
const firstStage=route.stages[0];
const lastStage=route.stages.at(-1);
const mapTitle=zh
  ? route.mapTitleZh??(firstStage&&lastStage?`从${firstStage.titleZh}到${lastStage.titleZh}`:name)
  : route.mapTitleEn??(firstStage&&lastStage?`From ${firstStage.titleEn??firstStage.titleZh} to ${lastStage.titleEn??lastStage.titleZh}`:name);
const dataset=buildRouteMapDataset(route,locale);
const tiles={urlTemplate:"https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",attribution:'&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',maxZoom:19};
const labels={map:zh?`${name}路线地图`:`Map of ${name}`,filters:zh?"筛选沿途地点":"Filter stops",relatedContent:zh?"相关内容":"Related content",openPlace:zh?"查看地点":"Open place",placesList:zh?`全部地图点（${places.length}）`:`All mapped places (${places.length})`,enableInteraction:zh?"启用地图拖动":"Enable map interaction",locateUser:zh?"我的位置":"My location",locatingUser:zh?"正在读取位置…":"Finding your location…",locationReady:zh?"已定位，蓝色圆点是你的位置":"Located. The blue dot is your position.",locationDenied:zh?"未获得定位权限，请在浏览器设置中允许位置访问":"Location permission was not granted.",locationUnavailable:zh?"暂时无法读取位置，请检查系统定位和网络":"Your location is currently unavailable.",placeId:zh?"地点编号":"Place ID",placeCategory:zh?"类型":"Type"};
const filterLabels=localizedPublicMapFilterLabels(locale);
const placeHref=(id:string)=>zh?`/zh/place/${id}`:`/place/${id}`;
const site=Astro.site??new URL("https://localdad.youzipal.com");
const alternates=[{lang:"en" as const,href:new URL(`/route/${route.slug}`,site).toString()},{lang:"zh" as const,href:new URL(`/zh/route/${route.slug}`,site).toString()}];
const pageDescription=zh
  ? `${name}的路线地图、核心停留点、沿途实地记录地点与出发前实用提醒，帮助旅行者理解路线骨架并安排途中停留。`
  : `Map, core stops, places along the way, and practical notes for ${name}.`;
const roleLabels={
  "core-stop":zh?"核心停留点":"Core stop", "secondary-stop":zh?"沿线停留点":"Additional stop",
  observation:zh?"观察点":"Observation stop", service:zh?"服务设施":"Service",
  junction:zh?"支线路口":"Junction", food:zh?"餐饮补给":"Food and supplies",
};
const visibleRole=(relationship:KnowledgeRoute["places"][number])=>relationship.role!=="secondary-stop"||relationship.showRoleLabel?roleLabels[relationship.role]:"";
const placeholder=(category:string)=>category.includes("茶")?"茶":category.includes("展馆")?"馆":category.includes("餐饮")?"食":category.includes("停车")?"停":category.includes("服务")?"服":category.includes("观景")?"景":"地";
---
<BaseLayout lang={locale} title={zh?`${name}｜武夷山奶爸地图`:`${name} | Local Dad Jeff`} description={pageDescription} {alternates}>
  <article class="route-page">
    <a class="route-back" href={zh?"/zh/map":"/map"}>← {zh?"返回完整地图":"Back to the full map"}</a>
    <header class="route-hero"><p class="route-kicker">{zh?"路线":"Route"}</p><h1>{name}</h1>{summary&&<p>{summary}</p>}<p class="route-scope">{zh?`${coreStopCount} 个核心停留点 · ${places.length} 个已记录地图点`:`${coreStopCount} core stops · ${places.length} mapped places`}</p><div class="route-trust">{coreStopCount>0&&<span><b aria-hidden="true">✓</b>{zh?`${coreStopCount} 个核心停留点中，${verifiedCoreCount} 个已实地核验`:`${verifiedCoreCount} of ${coreStopCount} core stops checked in person`}</span>}{recheck.length>0&&<span class="recheck"><b aria-hidden="true">⚠</b>{zh?`${recheck.length} 项出发前需复核`:`${recheck.length} item to recheck before going`}</span>}</div></header>

    <section class="route-map" aria-labelledby="route-map-title"><div><p class="route-kicker">{zh?"路线地图":"Route map"}</p><h2 id="route-map-title">{mapTitle}</h2></div><MapExplorer id={`${route.slug}-map`} {dataset} {tiles} {labels} {filterLabels} /></section>

    <section class="route-stages" aria-labelledby="route-stages-title"><p class="route-kicker">{zh?"路线骨架":"Route sequence"}</p><h2 id="route-stages-title">{zh?"沿线分段与地点":"Stages and places along the road"}</h2><div class="stage-list">{route.stages.map((stage,index)=>{
      const stageRelationships=route.places.filter((item)=>stage.placeIds.includes(item.placeId));
      const activeGroups=stage.groups??[];
      const groupedIds=new Set(activeGroups.flatMap((group)=>group.placeIds));
      const sections=[...activeGroups.map((group)=>({id:group.id,title:zh?group.titleZh:group.titleEn??group.titleZh,relationships:stageRelationships.filter((item)=>item.groupId===group.id)})),{id:"ungrouped",title:activeGroups.length?(zh?"本阶段其他地点":"Other places in this stage"):"",relationships:stageRelationships.filter((item)=>!groupedIds.has(item.placeId))}].filter((section)=>section.relationships.length);
      return <section class="stage"><div class="stage-heading"><span>{String(index+1).padStart(2,"0")}</span><h3>{zh?stage.titleZh:stage.titleEn??stage.titleZh}</h3></div>{sections.map((section)=>{const mainPlaces=section.relationships.filter((item)=>!["service","junction","food"].includes(item.role));const supportingPlaces=section.relationships.filter((item)=>["service","junction","food"].includes(item.role));return <div class="stage-group">{section.title&&<h4>{section.title}</h4>}<div class="stage-places">{mainPlaces.map((relationship)=>{const place=knowledgePlaceById.get(relationship.placeId);if(!place)return null;const photo=place.photoGallery?.[0];return <a href={placeHref(place.id)}>{photo?<img src={photo.src} alt="" width="120" height="90" loading="lazy" />:<span class="place-placeholder" aria-hidden="true">{placeholder(place.category)}</span>}<span><strong>{localizedPlaceName(place,locale)}{!zh&&place.nameEn&&<> <span aria-hidden="true">·</span> <span class="original-name">{place.nameZh}</span></>}</strong>{visibleRole(relationship)&&<small>{visibleRole(relationship)}</small>}</span><b aria-hidden="true">→</b></a>})}</div>{supportingPlaces.length>0&&<div class="stage-support"><p>{zh?"服务与路口":"Services and junctions"}</p><div>{supportingPlaces.map((relationship)=>{const place=knowledgePlaceById.get(relationship.placeId);return place?<a href={placeHref(place.id)}><strong>{localizedPlaceName(place,locale)}{!zh&&place.nameEn&&<> <span aria-hidden="true">·</span> <span>{place.nameZh}</span></>}</strong><small>{roleLabels[relationship.role]}</small></a>:null})}</div></div>}</div>})}</section>;
    })}</div></section>

    {(practicalNotes?.length??0)>0&&<section class="route-notes"><p class="route-kicker">{zh?"实用提醒":"Practical notes"}</p><ul>{practicalNotes?.map((note)=><li>{note}</li>)}</ul></section>}
    {recheck.length>0&&<section class="route-recheck"><p class="route-kicker">{zh?"出发前重新确认":"Recheck before you go"}</p><div>{recheck.map((place)=><a href={placeHref(place.id)}>{localizedPlaceName(place,locale)} <span>→</span></a>)}</div></section>}
    {(route.videos?.length??0)>0&&<section class="route-notes"><p class="route-kicker">{zh?"相关视频":"Field videos"}</p>{route.videos?.map((video)=><a href={video.url}>{video.title}</a>)}</section>}
  </article>
</BaseLayout>

<style>
  .route-page{max-width:1120px;margin:0 auto;padding:26px 18px 90px}.route-back{display:inline-block;margin-bottom:24px;color:#197152;font-weight:800;text-decoration:none}.route-hero{max-width:780px;padding:30px;border-radius:28px;background:#153f31;color:#fff}.route-kicker{margin:0 0 8px;color:#b96b3d;font-size:12px;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.route-hero .route-kicker{color:#efbb92}.route-hero h1{margin:0;font-size:clamp(42px,8vw,78px);line-height:1}.route-hero>p:not(.route-kicker){max-width:650px;margin:18px 0 0;color:#dce9e2;line-height:1.7}.route-hero .route-scope{color:#fff;font-weight:900}.route-trust{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}.route-trust span{display:inline-flex;align-items:center;gap:6px;padding:8px 11px;border-radius:999px;background:#fff;color:#1d5b45;font-size:12px;font-weight:900}.route-trust .recheck{background:#fff0e5;color:#8c4d28}.route-map,.route-stages,.route-notes,.route-recheck{margin-top:26px;padding:26px;border:1px solid #d7e3dd;border-radius:26px;background:#fff}.route-map h2,.route-stages h2{margin:0 0 18px;color:#143c2f}.route-map :global(.map-fallback){margin-top:4px}.route-map :global(.interactive-map){min-height:min(64vh,570px)}.stage-list{display:grid;gap:18px}.stage{padding-top:18px;border-top:1px solid #dce6e1}.stage-heading{display:flex;align-items:baseline;gap:12px}.stage-heading>span{color:#b1683f;font-weight:900}.stage-heading h3{margin:0;color:#143c2f;font-size:24px}.stage-group>h4{margin:16px 0 4px;color:#6d4a34;font-size:16px}.stage-places{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:12px}.stage-places a{display:grid;grid-template-columns:54px minmax(0,1fr) auto;align-items:center;gap:10px;min-height:68px;padding:8px;border-radius:14px;background:#eef5f1;color:#174f3c;text-decoration:none}.stage-places img{width:54px;height:54px;border-radius:10px;object-fit:cover}.place-placeholder{display:grid;place-items:center;width:46px;height:46px;margin:auto;border-radius:13px;background:#d9e9e1;color:#176348;font-weight:900}.stage-places a>span:not(.place-placeholder){display:grid;gap:2px}.stage-places small{color:#687a72;font-size:11px}.original-name{font-weight:600}.stage-support{margin-top:13px;padding:12px 14px;border-radius:14px;background:#faf8f2}.stage-support>p{margin:0 0 8px;color:#7b6755;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.06em}.stage-support>div{display:flex;flex-wrap:wrap;gap:7px}.stage-support a{display:grid;gap:2px;padding:8px 10px;border:1px solid #e3ddd1;border-radius:10px;background:#fff;color:#315347;text-decoration:none}.stage-support small{color:#7a827e;font-size:10px}.route-recheck>div{display:flex;flex-wrap:wrap;gap:8px}.route-recheck a{padding:10px 13px;border-radius:12px;background:#fff0e5;color:#794121;font-weight:800;text-decoration:none}
  @media(max-width:650px){.route-page{padding:14px 10px 70px}.route-hero,.route-map,.route-stages,.route-notes,.route-recheck{padding:18px;border-radius:20px}.route-hero h1{font-size:46px}.stage-places{grid-template-columns:1fr}.route-map :global(.interactive-map){min-height:58vh}}
</style>
