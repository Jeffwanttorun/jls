---
interface Props {
  title: string; description: string; href: string; eyebrow?: string;
  image?: string; imageSrcset?: string; imageAlt?: string; imageWidth?: number; imageHeight?: number; tags?: string[]; compact?: boolean;
}
const { title, description, href, eyebrow, image, imageSrcset, imageAlt = "", imageWidth, imageHeight, tags = [], compact = false } = Astro.props;
---
<article class:list={["content-card", { compact, "has-image": image }]}>
  {image && <a class="content-card-image" href={href} aria-label={`Read about ${title}`}><img src={image} srcset={imageSrcset} sizes="(max-width: 800px) 88vw, 520px" alt={imageAlt} width={imageWidth} height={imageHeight} loading="lazy" decoding="async" /></a>}
  <div class="content-card-body">
    {eyebrow && <p class="kicker">{eyebrow}</p>}
    <h3><a href={href}>{title}</a></h3>
    <p>{description}</p>
    {tags.length > 0 && <ul class="tag-list" aria-label="Topics">{tags.map((tag) => <li>{tag}</li>)}</ul>}
    <a class="text-link" href={href}>Read more <span aria-hidden="true">→</span></a>
  </div>
</article>
