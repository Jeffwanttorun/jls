---
import { localizedThemeDescription, localizedThemeName, visitorThemes } from "../data/visitor-themes";
import type { Locale } from "../i18n/config";
interface Props { compact?: boolean; locale?:Locale; }
const { compact = false,locale="zh" } = Astro.props;
const zh=locale==="zh";
---
<section class:list={["dad-theme-section", compact && "compact"]} aria-labelledby="dad-theme-heading">
  <div class="dad-section-heading">
    <div><h2 id="dad-theme-heading">{zh?"按兴趣找地方":"Explore by Interest"}</h2></div>
    <p>{zh?"一个地方可以同时属于多个主题。":"A place may appear under more than one interest."}</p>
  </div>
  <nav class="dad-theme-grid" aria-label={zh?"兴趣主题":"Interests"}>
    {visitorThemes.map((theme) => (
      <a href={zh?`/zh/theme/${theme.id}`:`/theme/${theme.id}`} class={theme.tone} data-theme-link>
        <span class="dad-theme-icon" aria-hidden="true">{theme.icon}</span>
        <strong>{localizedThemeName(theme,locale)}</strong>
        <small>{localizedThemeDescription(theme,locale)}</small>
        <b aria-hidden="true">→</b>
      </a>
    ))}
  </nav>
</section>
