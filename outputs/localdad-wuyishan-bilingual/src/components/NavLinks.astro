---
import { primaryNav } from "../data/site";
import { localizedPath, type Locale } from "../i18n/config";
interface Props { locale: Locale; labels: Record<string, string>; current: string; }
const { locale, labels, current } = Astro.props;
const navigation = primaryNav;
const isCurrent = (href: string) => {
  const target = localizedPath(href, locale);
  if (current === target) return true;
  if (href === "/why-wuyishan") return current.startsWith(`${target}/`);
  if (href === "/explore-wuyishan") {
    const explorePaths = ["/wuyishan-guide", "/guides", "/locations", "/main-scenic-area", "/family-travel", "/wuyi-rock-tea"];
    return explorePaths.some((path) => {
      const localized = localizedPath(path, locale);
      return current === localized || current.startsWith(`${localized}/`);
    });
  }
  if (href === "/stories-of-wuyishan") {
    return ["/people", "/local-stories", "/videos"].some((path) => {
      const localized = localizedPath(path, locale);
      return current === localized || current.startsWith(`${localized}/`);
    });
  }
  if (href === "/map") return current === target || current.startsWith(`${target}/`);
  return false;
};
---
{navigation.map(({key, href}) => <a href={localizedPath(href, locale)} aria-current={isCurrent(href) ? "page" : undefined}>{labels[key]}</a>)}
