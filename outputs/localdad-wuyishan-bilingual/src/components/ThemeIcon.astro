---
interface Props { id:"water"|"scenery"|"nature"|"museum"|"food"|"camping"; class?:string; }
const { id,class:className }=Astro.props;
---
<svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {id==="water"&&<path d="M3 8c2.3 0 2.3-2 4.6-2s2.3 2 4.6 2 2.3-2 4.6-2S19.1 8 21 8M3 13c2.3 0 2.3-2 4.6-2s2.3 2 4.6 2 2.3-2 4.6-2 2.3 2 4.2 2M3 18c2.3 0 2.3-2 4.6-2s2.3 2 4.6 2 2.3-2 4.6-2 2.3 2 4.2 2"/>}
  {id==="scenery"&&<path d="m3 19 6.2-10 3.2 4.4L15.7 8 21 19H3Zm1.8 0h14.5M16.8 5.2a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/>}
  {id==="nature"&&<path d="M19.5 4.5C12.2 4.7 6.1 8 5.2 14.1c-.5 3.4 2.3 5.7 5.5 4.8 5.9-1.7 8.2-7.9 8.8-14.4ZM5 21c2.2-5.2 5.8-8.4 10.7-10.8"/>}
  {id==="museum"&&<path d="M3 9h18L12 3 3 9Zm2 2v7m4-7v7m6-7v7m4-7v7M3 21h18"/>}
  {id==="food"&&<path d="M7 3v7m-3-7v4c0 2 1.3 3 3 3s3-1 3-3V3M7 10v11m7-8h5V3c-3 0-5 2.4-5 5.5V13Zm3 0v8"/>}
  {id==="camping"&&<path d="M4 18 12 5l8 13H4Zm8-13v13m-4 0 4-6 4 6M3 21h18"/>}
</svg>
<style>
  svg{width:1.45em;height:1.45em;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
</style>
