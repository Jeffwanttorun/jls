---
import "leaflet/dist/leaflet.css";
import { mapFilterIds, type MapFilterId } from "../data/map-filters";
import type { MapDataset, MapExplorerLabels, MapTileConfiguration } from "../types/map";
import MapFilterControls from "./MapFilterControls.astro";

interface Props {
  id: string;
  dataset: MapDataset;
  tiles: MapTileConfiguration;
  labels: MapExplorerLabels;
  filterLabels: Partial<Record<MapFilterId, string>>;
  focusPlaceId?: string;
  autoScrollToFocus?: boolean;
  openFocusedPopup?: boolean;
}

const { id, dataset, tiles, labels, filterLabels, focusPlaceId, autoScrollToFocus=true, openFocusedPopup=true } = Astro.props;
const availableFilters = new Set(dataset.places.flatMap((place) => place.filterIds));
const filters = mapFilterIds.filter((filterId) => availableFilters.has(filterId));
const config = JSON.stringify({ dataset, tiles, labels, focusPlaceId, autoScrollToFocus, openFocusedPopup }).replaceAll("<", "\\u003c");
---
{dataset.places.length > 0 && <section id={id} class="map-explorer" data-map-explorer>
  <div class="map-controls"><MapFilterControls filterIds={filters} labels={filterLabels} legend={labels.filters} /></div>
  <div class="map-frame">
    <div class="interactive-map" data-map-canvas role="region" aria-label={labels.map} tabindex="0"></div>
    <button class="map-locate" type="button" data-map-locate aria-label={labels.locateUser} title={labels.locateUser}><span aria-hidden="true">◎</span><span>{labels.locateUser}</span></button>
    <p class="map-status" data-map-status aria-live="polite" hidden></p>
  </div>
  <details class="map-fallback"><summary>{labels.placesList}</summary><ul>{dataset.places.map((place) => <li><a href={place.href}>{place.name}</a>{place.alternateName && ` · ${place.alternateName}`}</li>)}</ul></details>
  <script type="application/json" data-map-config is:inline set:html={config} />
</section>}

<script>
  import { canonicalPublicMapFilter } from "../data/map-filters";
  import type { MapDataset, MapExplorerLabels, MapTileConfiguration } from "../types/map";

  interface RuntimeConfig {
    dataset: MapDataset;
    tiles: MapTileConfiguration;
    labels: MapExplorerLabels;
    focusPlaceId?: string;
    autoScrollToFocus?: boolean;
    openFocusedPopup?: boolean;
  }

  async function initializeMap(root: HTMLElement) {
    if (root.dataset.mapReady === "true") return;
    root.dataset.mapReady = "true";
    const canvas = root.querySelector<HTMLElement>("[data-map-canvas]");
    const source = root.querySelector<HTMLScriptElement>("[data-map-config]");
    if (!canvas || !source?.textContent) return;
    const { default:L } = await import("leaflet");
    const { dataset, tiles, labels, focusPlaceId, autoScrollToFocus=true, openFocusedPopup=true } = JSON.parse(source.textContent) as RuntimeConfig;
    const map = L.map(canvas, { scrollWheelZoom:false, keyboard:true, dragging:true, touchZoom:true, doubleClickZoom:true, boxZoom:true, zoomControl:true });
    L.tileLayer(tiles.urlTemplate, { attribution:tiles.attribution, maxZoom:tiles.maxZoom ?? 19 }).addTo(map);
    const routeLayer = L.layerGroup().addTo(map);
    const placeLayer = L.layerGroup().addTo(map);
    const availableFilters = new Set<string>(dataset.places.flatMap((place)=>place.filterIds));
    const filtersFromUrl = () => new URLSearchParams(window.location.search).get("category")?.split(",").map((value)=>canonicalPublicMapFilter(value)??value).filter((value)=>availableFilters.has(value))??[];
    const activeFilters = new Set<string>(filtersFromUrl());
    const requestedPlaceId = focusPlaceId || new URLSearchParams(window.location.search).get("place");
    let selectedPlaceId = requestedPlaceId || undefined;
    let focusedPlaceId: string | undefined;
    let labelFrame = 0;

    const placeMarkers = dataset.places.map((place) => {
      const marker = L.circleMarker([place.coordinates.latitude, place.coordinates.longitude], { radius:7, weight:2, color:"#183a2c", fillColor:"#d8a94f", fillOpacity:.9, bubblingMouseEvents:false });
      const popup = document.createElement("div");
      const heading = document.createElement("strong");
      heading.textContent = place.alternateName ? `${place.name} · ${place.alternateName}` : place.name;
      popup.append(heading);
      if(/^WY-\d+$/.test(place.id)){
        const metadata=document.createElement("p"); metadata.className="map-popup-meta";
        metadata.textContent=`${labels.placeId}：${place.id} · ${labels.placeCategory}：${place.category}`;
        popup.append(metadata);
      }
      if (place.summary) { const summary = document.createElement("p"); summary.textContent = place.summary; popup.append(summary); }
      const link = document.createElement("a"); link.href = place.href; link.textContent = labels.openPlace; popup.append(link);
      const relationships = [...place.relatedRoutes, ...place.relatedStories];
      if (relationships.length > 0 || place.relatedVideos.length > 0) {
        const relatedHeading = document.createElement("strong"); relatedHeading.textContent = labels.relatedContent; popup.append(relatedHeading);
        const list = document.createElement("ul");
        for (const relationship of relationships) { const item=document.createElement("li"); const anchor=document.createElement("a"); anchor.href=relationship.href; anchor.textContent=relationship.label; item.append(anchor); list.append(item); }
        for (const video of place.relatedVideos) { const item=document.createElement("li"); const anchor=document.createElement("a"); anchor.href=video.url; anchor.textContent=video.title; item.append(anchor); list.append(item); }
        popup.append(list);
      }
      marker.bindPopup(popup);
      marker.bindTooltip(place.shortName || place.name, { permanent:true, direction:"top", offset:[0,-7], className:"map-place-label", interactive:false });
      marker.on("add",()=>{const element=marker.getElement() as HTMLElement|undefined;if(element){element.dataset.placeId=place.id;element.setAttribute("role","button");element.setAttribute("aria-label",place.name);}});
      return { place, marker };
    });

    if (!requestedPlaceId) for (const route of dataset.routes) L.polyline(route.path.map((point) => [point.latitude, point.longitude]), { color:"#167252", weight:4, opacity:.78 }).addTo(routeLayer);

    const refresh = () => {
      placeLayer.clearLayers();
      for (const { place, marker } of [...placeMarkers].sort((a,b)=>a.place.labelPriority-b.place.labelPriority||a.place.id.localeCompare(b.place.id))) {
        const matchesScope = !requestedPlaceId || place.id === requestedPlaceId;
        const matches = matchesScope && (activeFilters.size === 0 || place.filterIds.some((filterId) => activeFilters.has(filterId)));
        if (matches) {
          marker.addTo(placeLayer);
        }
      }
      for(const button of root.querySelectorAll<HTMLButtonElement>("button[data-filter]"))button.setAttribute("aria-pressed",String(activeFilters.has(button.dataset.filter!)));
    };

    const writeFiltersToUrl = () => {
      const url=new URL(window.location.href);
      const values=[...activeFilters];
      if(values.length)url.searchParams.set("category",values.join(","));else url.searchParams.delete("category");
      history.pushState({mapCategory:true},"",url);
      window.dispatchEvent(new Event("urlstatechange"));
    };

    const readFiltersFromUrl = () => {
      activeFilters.clear();
      for(const value of filtersFromUrl())activeFilters.add(value);
      refresh();
      requestAnimationFrame(renderPlaceLabels);
    };

    const labelForZoom = (place:MapDataset["places"][number], zoom:number) => {
      if(place.id===selectedPlaceId || place.id===focusedPlaceId)return place.name;
      if(zoom<=10)return undefined;
      if(zoom===11)return place.labelPriority>=100?place.shortName:undefined;
      if(zoom===12)return place.labelPriority>=80?place.shortName:undefined;
      if(zoom===13)return place.labelPriority>=60?(place.labelPriority>=100?place.name:place.shortName):undefined;
      if(zoom===14)return place.labelPriority>=40?(place.labelPriority>=80?place.name:place.shortName):undefined;
      return place.name;
    };

    const renderPlaceLabels = () => {
      cancelAnimationFrame(labelFrame);
      const zoom=map.getZoom(); root.dataset.mapZoom=String(zoom); root.dataset.labelMode=zoom<=10?"points":zoom===11?"core-short":zoom===12?"important-short":zoom===13?"more-short":zoom===14?"mixed":"full";
      const bounds=map.getBounds().pad(.08);
      const candidates=placeMarkers.flatMap(({place,marker})=>{
        const text=labelForZoom(place,zoom);
        marker.setStyle(place.id===selectedPlaceId?{radius:9,weight:3,color:"#fff",fillColor:"#1671d9",fillOpacity:1}:{radius:7,weight:2,color:"#183a2c",fillColor:"#d8a94f",fillOpacity:.9});
        marker.closeTooltip();
        if(!placeLayer.hasLayer(marker)||!bounds.contains(marker.getLatLng())||!text)return [];
        marker.setTooltipContent(text).openTooltip();
        return [{place,marker,text,selected:place.id===selectedPlaceId,focused:place.id===focusedPlaceId}];
      }).sort((a,b)=>Number(b.selected)-Number(a.selected)||Number(b.focused)-Number(a.focused)||b.place.labelPriority-a.place.labelPriority||a.place.id.localeCompare(b.place.id));
      labelFrame=requestAnimationFrame(()=>{
        const occupied:{left:number;right:number;top:number;bottom:number}[]=[];
        for(const candidate of candidates){
          const element=candidate.marker.getTooltip()?.getElement();
          if(!element)continue;
          const box=element.getBoundingClientRect();
          const padded={left:box.left-5,right:box.right+5,top:box.top-4,bottom:box.bottom+4};
          const overlaps=occupied.some((other)=>!(padded.right<other.left||padded.left>other.right||padded.bottom<other.top||padded.top>other.bottom));
          if(overlaps&&!candidate.selected&&!candidate.focused)candidate.marker.closeTooltip();
          else occupied.push(padded);
        }
        root.dataset.visibleLabels=String(occupied.length);
      });
    };

    for(const {place,marker} of placeMarkers){
      marker.on("click",()=>{selectedPlaceId=place.id; focusedPlaceId=undefined; marker.openPopup(); renderPlaceLabels();});
      marker.on("mouseover",()=>{focusedPlaceId=place.id; renderPlaceLabels();});
      marker.on("mouseout",()=>{focusedPlaceId=undefined; renderPlaceLabels();});
    }
    map.on("click",()=>{selectedPlaceId=undefined; focusedPlaceId=undefined; map.closePopup(); renderPlaceLabels();});

    for (const group of root.querySelectorAll<HTMLElement>("[data-filter-group]")) {
      for (const button of group.querySelectorAll<HTMLButtonElement>("button[data-filter]")) button.addEventListener("click", () => {
        const value = button.dataset.filter!;
        activeFilters.has(value) ? activeFilters.delete(value) : activeFilters.add(value);
        writeFiltersToUrl();
        refresh();
        requestAnimationFrame(renderPlaceLabels);
      });
    }
    window.addEventListener("popstate",readFiltersFromUrl);

    refresh();
    map.on("zoomend moveend",renderPlaceLabels);
    const requested = placeMarkers.find(({ place }) => place.id === requestedPlaceId);
    if (requested) {
      map.setView([requested.place.coordinates.latitude, requested.place.coordinates.longitude], 15);
      if (openFocusedPopup) requested.marker.openPopup();
      if (autoScrollToFocus) requestAnimationFrame(() => root.scrollIntoView({ block:"start" }));
    } else {
      const bounds = L.latLngBounds([
        ...dataset.places.map((place) => [place.coordinates.latitude, place.coordinates.longitude] as [number,number]),
        ...dataset.routes.flatMap((route) => route.path.map((point) => [point.latitude, point.longitude] as [number,number])),
      ]);
      map.fitBounds(bounds, { padding:[24,24], maxZoom:14 });
    }
    renderPlaceLabels();

    const locateButton = root.querySelector<HTMLButtonElement>("[data-map-locate]");
    const status = root.querySelector<HTMLElement>("[data-map-status]");
    let userMarker: ReturnType<typeof L.circleMarker> | undefined;
    let accuracyCircle: ReturnType<typeof L.circle> | undefined;
    const setStatus = (message:string) => { if(status){ status.textContent=message; status.hidden=false; } };
    locateButton?.addEventListener("click", () => {
      if(!navigator.geolocation){ setStatus(labels.locationUnavailable); return; }
      locateButton.disabled=true;
      setStatus(labels.locatingUser);
      navigator.geolocation.getCurrentPosition((position) => {
        const point=L.latLng(position.coords.latitude,position.coords.longitude);
        userMarker?.remove(); accuracyCircle?.remove();
        accuracyCircle=L.circle(point,{radius:Math.max(position.coords.accuracy,12),weight:1,color:"#1671d9",fillColor:"#1671d9",fillOpacity:.08}).addTo(map);
        userMarker=L.circleMarker(point,{radius:7,weight:3,color:"#fff",fillColor:"#1671d9",fillOpacity:1,className:"map-user-location"}).addTo(map).bindPopup(labels.locationReady).openPopup();
        map.setView(point,Math.max(map.getZoom(),15));
        locateButton.disabled=false;
        setStatus(labels.locationReady);
      },(error) => {
        locateButton.disabled=false;
        setStatus(error.code===error.PERMISSION_DENIED?labels.locationDenied:labels.locationUnavailable);
      },{enableHighAccuracy:true,timeout:12000,maximumAge:60000});
    });
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-map-explorer]")) {
    if (!("IntersectionObserver" in window)) void initializeMap(root);
    else {
      const observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        void initializeMap(root);
      }, { rootMargin:"300px" });
      observer.observe(root);
    }
  }
</script>

<style>
  .map-explorer{display:grid;gap:1rem}.map-frame{position:relative}.interactive-map{min-height:28rem;border-radius:1rem;overflow:hidden;background:var(--mist);touch-action:pan-x pan-y}.interactive-map:focus-visible{outline:3px solid var(--focus, #b36b2c);outline-offset:3px}.map-locate{position:absolute;top:10px;right:10px;z-index:500;display:flex;align-items:center;gap:6px;min-height:40px;padding:8px 11px;border:1px solid #c7d7cf;border-radius:10px;background:rgba(255,255,255,.96);color:#174c39;font:800 12px/1 system-ui,sans-serif;box-shadow:0 2px 8px rgb(0 0 0/.16);cursor:pointer}.map-locate>span:first-child{font-size:18px}.map-locate:disabled{opacity:.62}.map-locate:focus-visible{outline:3px solid var(--focus, #b36b2c);outline-offset:3px}.map-status{position:absolute;inset:auto 10px 10px;z-index:500;margin:0;padding:9px 12px;border-radius:10px;background:rgba(20,57,44,.92);color:#fff;font:700 11px/1.45 system-ui,sans-serif;box-shadow:0 2px 10px rgb(0 0 0/.2)}.map-fallback{font-size:.95rem}.map-explorer :global(.map-place-label){border:1px solid #c8d8d0;border-radius:7px;background:rgba(255,255,255,.96);color:#173b2f;font:800 11px/1.2 system-ui,sans-serif;box-shadow:0 2px 7px rgb(0 0 0/.14);white-space:nowrap}.map-explorer :global(.map-place-label::before){display:none}.map-explorer :global(.map-popup-meta){margin:6px 0;color:#60736a;font-size:11px;line-height:1.45}
  @media(max-width:700px){.interactive-map{min-height:min(65vh,34rem)}}
</style>
