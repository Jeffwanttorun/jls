---
interface Props { title: string; description: string; href: string; category: string; audience?: string[]; }
const { title, description, href, category, audience = [] } = Astro.props;
---
<article class="guide-card">
  <p class="kicker">{category}</p>
  <h3><a href={href}>{title}</a></h3>
  <p>{description}</p>
  {audience.length > 0 && <ul class="tag-list" aria-label="Intended readers">{audience.map((item) => <li>{item}</li>)}</ul>}
  <a class="text-link" href={href}>Read guide <span aria-hidden="true">→</span></a>
</article>
