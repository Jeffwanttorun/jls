NODE_ENV=production
HOST=127.0.0.1
PORT=3001

# Set these only on the server. Never commit the real values.
ADMIN_PASSWORD=replace-with-a-long-unique-password
DATABASE_URL=postgresql://localdad:replace-me@127.0.0.1:5432/localdad

VISITOR_CONTENT_STORE_PATH=/srv/localdad/data/visitor-content/data.json
VISITOR_CONTENT_MEDIA_DIR=/srv/localdad/data/visitor-content/media
VISITOR_CONTENT_BACKUP_DIR=/srv/localdad/backups/visitor-content
CONTENT_STUDIO_SEED_PATH=/srv/localdad/source/map/content-studio-store/seed.json
CONTENT_STUDIO_SNAPSHOT_PATH=/srv/localdad/data/content-studio/published.json

SITE_PROJECT_DIR=/srv/localdad/source/site
SITE_PUBLISH_SCRIPT=/srv/localdad/source/site/scripts/publish-site.mjs
SITE_RELEASES_DIR=/srv/localdad/releases
SITE_CURRENT_LINK=/srv/localdad/releases/current
SITE_BACKUP_DIR=/srv/localdad/backups/publications
SITE_PACKAGE_MANAGER=/usr/bin/pnpm
SITE_URL=https://your-subdomain.example.com
